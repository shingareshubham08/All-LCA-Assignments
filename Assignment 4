#include<stdio.h>
int main() {
  int r, c, i, j;
  printf("Enter rows and columns: ");
  scanf("%d %d", &r, &c);
  int sensor1[r][c], sensor2[r][c], sum[r][c];
  
  printf("Enter elements of sensor1: \n");
   for(i=0; i<r; i++) {
    for(j=0; j<c; j++) {
     scanf("%d", &sensor1[i][j]);
     }}
  printf("Enter elements of sensor2: \n");
   for(i=0; i<r; i++) {
    for(j=0; j<c; j++) {
     scanf("%d", &sensor2[i][j]);
     }}
  printf("Adding sensor1 and sensor2\n");
   for(i=0; i<r; i++) {
    for(j=0; j<c; j++) {
      sum[i][j]=sensor1[i][j]+sensor2[i][j];
   }}
  printf("\nResult:\n");
   for(i=0; i<r; i++) {
    for(j=0; j<c; j++) {
     printf("%d", sum[i][j]);
     printf("\n");
     }}
     return 0;
}
