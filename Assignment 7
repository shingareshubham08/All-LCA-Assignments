#include <stdio.h> 
#include <string.h>

#define MAX_SENSORS 10

struct Sensor { int id; char type[30]; float distance; float threshold; char status[30]; char risk[30]; };

int main() {

int n, hr = 0, mr = 0, lr = 0;

struct Sensor s[MAX_SENSORS];

printf("Enter number of sensors: ");
scanf("%d", &n);

if (n < 1 || n > MAX_SENSORS) {
    printf("Invalid number of sensors!");
    return 1;
}

for (int i = 0; i < n; i++) {

    printf("\nSensor %d\n", i + 1);

    printf("ID: ");
    scanf("%d", &s[i].id);

    printf("Type: ");
    scanf("%29s", s[i].type);

    printf("Distance (cm): ");
    scanf("%f", &s[i].distance);

    printf("Threshold (cm): ");
    scanf("%f", &s[i].threshold);

    if (s[i].distance <= s[i].threshold) {

        strcpy(s[i].risk, "High Risk");
        strcpy(s[i].status, "Obstacle Detected");
        hr++;

    }
    else if (s[i].distance <= 1.5 * s[i].threshold) {

        strcpy(s[i].risk, "Medium Risk");
        strcpy(s[i].status, "Path Clear");
        mr++;

    }
    else {

        strcpy(s[i].risk, "Low Risk");
        strcpy(s[i].status, "Path Clear");
        lr++;

    }
}

printf("\n\n========== SENSOR RISK STATUS ==========\n");

printf("\nID\tType\tDistance\tThreshold\tStatus\t\t\tRisk\n");

printf("--------------------------------------------------------------------------\n");

for (int j = 0; j < n; j++) {

    printf("%d\t%s\t%.2f\t\t%.2f\t\t%-20s %s\n",
           s[j].id,
           s[j].type,
           s[j].distance,
           s[j].threshold,
           s[j].status,
           s[j].risk);
}

printf("\n========== RISK SUMMARY ==========\n");

printf("High Risk Sensors   : %d\n", hr);
printf("Medium Risk Sensors : %d\n", mr);
printf("Low Risk Sensors    : %d\n", lr);

  return 0;
}
